@model IEnumerable<Demo01.Models.Reservation>

@{
    ViewData["Title"] = "Danh sách Reservation";
}

<div class="alert alert-info" role="alert">
    <strong>Info:</strong> Code đang dùng <code>HttpClient.GetAsync()</code> để gọi API lấy danh sách. (Theo Slide 13)
</div>

<h2>Danh sách Reservation</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Start Location</th>
            <th>End Location</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.StartLocation</td>
            <td>@item.EndLocation</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit (PUT)</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this?');">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

<!-- Form Test Patch -->
<div class="card mt-4">
    <div class="card-header bg-secondary text-white">
        Test Partial Update (PATCH) - Slide 33
    </div>
    <div class="card-body">
         <form asp-action="PatchUpdate" method="post" class="row g-3">
             <div class="col-auto">
                 <input type="number" name="id" class="form-control" placeholder="ID to Patch" required>
             </div>
             <div class="col-auto">
                 <input type="text" name="name" class="form-control" placeholder="New Name" required>
             </div>
             <div class="col-auto">
                 <button type="submit" class="btn btn-success mb-3">Test Patch Name</button>
             </div>
         </form>
         <small class="text-muted">Nhập ID có tồn tại và Tên mới để test gọi API PATCH.</small>
    </div>
</div>
